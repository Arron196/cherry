        <mxCell id="17" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;兼容回退&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;仅当设备未注册时&lt;br/&gt;回退 INGEST_SIGNING_KEYS&lt;br/&gt;只支持 HMAC&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E8E9D;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="11">
