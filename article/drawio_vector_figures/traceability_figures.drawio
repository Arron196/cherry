          <mxGeometry x="60" y="545" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;STM32H743&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;I2C1 / I2C2&lt;br/&gt;USART1 / USART2&lt;br/&gt;SPI1&lt;br/&gt;HASH&lt;/div&gt;" style="shape=mxgraph.electrical.int_ic;html=1;whiteSpace=wrap;fillColor=#EDF4FB;strokeColor=#2F6DB2;strokeWidth=1.5;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="1">
