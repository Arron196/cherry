          <mxGeometry x="1090" y="180" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;SHT31&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;I2C1 / 0x44&lt;br/&gt;PB8 / PB9&lt;br/&gt;CRC 校验&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2F6DB2;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="10">
          <mxGeometry x="100" y="235" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;ATECC608A&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;I2C1 / 0x60&lt;br/&gt;Never-Read 私钥&lt;br/&gt;执行 ECDSA Sign&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E8E9D;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="10">
          <mxGeometry x="100" y="390" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;MH-Z19B&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;USART1 / 9600 8N1&lt;br/&gt;5V 供电&lt;br/&gt;预热 3 分钟&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E8E9D;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="11">
          <mxGeometry x="100" y="600" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;ESP8266&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;USART2 / 115200&lt;br/&gt;AT + HTTPS&lt;br/&gt;主上传通道&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF4FB;strokeColor=#2F6DB2;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="13">
          <mxGeometry x="1140" y="255" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;SX1278&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;SPI1 + GPIO&lt;br/&gt;433MHz&lt;br/&gt;备用链路&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E8E9D;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="13">
          <mxGeometry x="1140" y="430" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;总线设计要点：&lt;br/&gt;I2C1 共享但地址不同；UART 直接 3.3V 连接；LoRa 需要额外 NSS / RESET / DIO0。&lt;/div&gt;" style="shape=note;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A9B7C4;strokeWidth=1.2;fontColor=#66788A;spacingTop=16;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1080" y="665" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="1000" value="I2C1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2F6DB2;strokeWidth=2.2;fontSize=14;fontColor=#2F6DB2;" edge="1" parent="1" source="14" target="12">
