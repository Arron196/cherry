        </mxCell>
        <mxCell id="12" value="&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;I2C 时序：&lt;br/&gt;Wakeup -&amp;gt; 命令帧&lt;br/&gt;(Length / OpCode / Param / Data / CRC16)&lt;br/&gt;-&amp;gt; 等待执行 -&amp;gt; 读响应 -&amp;gt; Sleep&lt;/div&gt;" style="shape=note;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A9B7C4;strokeWidth=1.2;fontColor=#66788A;spacingTop=16;spacingLeft=16;spacingRight=16;" vertex="1" parent="10">
          <mxGeometry x="100" y="485" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;div style='font-family:Microsoft YaHei;font-size:20px;font-weight:700;color:#1F2D3D;margin-bottom:6px;text-align:left'&gt;1 数据帧构造&lt;/div&gt;&lt;div style='font-family:Microsoft YaHei;font-size:18px;color:#1F2D3D;line-height:1.35;text-align:left'&gt;SensorTask&lt;br/&gt;采集并组装 JSON&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2F6DB2;strokeWidth=1.5;arcSize=8;fontColor=#1F2D3D;spacingTop=18;spacingLeft=18;spacingRight=18;" vertex="1" parent="1">
